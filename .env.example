# Local development only. Never commit a real .env file.
# Generate a password with: openssl rand -base64 18
# It must not contain '#', '$' or spaces, because the Makefile passes it on.
API_ADDRESS=:8080
POSTGRES_PASSWORD=replace-with-a-random-local-password
FRONTEND_ORIGIN=http://localhost:3000
DB_MAX_OPEN=10
DB_MAX_IDLE=5
